# Copy to .env at the project root.

# Your own key, from https://console.videodb.io
VIDEO_DB_API_KEY=your-key

# The shipped corpus, public and read-only: any key can query it, so the archive works without
# re-ingesting 240 minutes of video. Replace this with your own collection id if you rebuild the
# corpus, and note that ingest and indexing only ever work against a collection you own.
#
# Never leave this blank. `conn.get_collection()` with no argument returns the account default,
# and collection-scoped search fans out over every indexed video in scope, which would mix
# unrelated footage into every result.
VIDEODB_COLLECTION_ID=c-9e6ed4ba-1016-46d3-ab43-1ef08f8741b1
